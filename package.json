{
  "name": "nameblocks",
  "private": true,
  "type": "module",
  "description": "UK and Irish baby names: swipe, compare, rank. Static site, no build step.",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "serve": "python scripts/serve.py",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/gh-test-reporter.mjs --test-reporter-destination=stdout \"test/**/*.test.js\"",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0"
  }
}
